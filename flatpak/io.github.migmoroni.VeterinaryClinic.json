{
  "app-id": "io.github.migmoroni.VeterinaryClinic",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "veterinary_clinic",
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--device=dri"
  ],
  "modules": [
    {
      "name": "veterinary-clinic",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 bin/veterinary_clinic /app/bin/veterinary_clinic",
        "install -Dm644 share/applications/io.github.migmoroni.VeterinaryClinic.desktop /app/share/applications/io.github.migmoroni.VeterinaryClinic.desktop",
        "install -Dm644 share/metainfo/io.github.migmoroni.VeterinaryClinic.metainfo.xml /app/share/metainfo/io.github.migmoroni.VeterinaryClinic.metainfo.xml",
        "install -Dm644 share/icons/hicolor/32x32/apps/io.github.migmoroni.VeterinaryClinic.png /app/share/icons/hicolor/32x32/apps/io.github.migmoroni.VeterinaryClinic.png",
        "install -Dm644 share/icons/hicolor/128x128/apps/io.github.migmoroni.VeterinaryClinic.png /app/share/icons/hicolor/128x128/apps/io.github.migmoroni.VeterinaryClinic.png",
        "install -Dm644 share/icons/hicolor/256x256/apps/io.github.migmoroni.VeterinaryClinic.png /app/share/icons/hicolor/256x256/apps/io.github.migmoroni.VeterinaryClinic.png",
        "install -Dm644 share/doc/veterinary-clinic/LICENSE.md /app/share/doc/veterinary-clinic/LICENSE.md",
        "install -Dm644 share/doc/veterinary-clinic/CHANGELOG.md /app/share/doc/veterinary-clinic/CHANGELOG.md"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "staging"
        }
      ]
    }
  ]
}