{
	"name": "veterinary-clinic-workspace",
	"private": true,
	"version": "0.2.0",
	"type": "module",
	"packageManager": "pnpm@11.22.0",
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"preinstall": "node scripts/ensure-pnpm.mjs",
		"dev": "pnpm --filter vet-app run dev",
		"build": "pnpm --filter vet-app run build",
		"preview": "pnpm --filter vet-app run preview",
		"check": "pnpm --filter vet-app run check",
		"check:watch": "pnpm --filter vet-app run check:watch",
		"test": "pnpm --filter vet-app run test",
		"test:run": "pnpm --filter vet-app run test:run",
		"knowledge:audit": "node scripts/audit-knowledge.mjs",
		"knowledge:validate": "cargo run -p knowledge-builder -- validate --source data/knowledge",
		"knowledge:build": "cargo run -p knowledge-builder -- build --source data/knowledge --output build/knowledge-artifacts --context tools/knowledge-builder/fixtures/local-context.json",
		"adopt:version": "pnpm --filter @vet/legacy-to-sqlite run adopt:version",
		"version:bump": "node scripts/bump-version/index.mjs",
		"tauri": "pnpm --filter vet-app run tauri",
		"tauri:dev": "pnpm --filter vet-app run tauri:dev",
		"tauri:dev:new": "pnpm --filter vet-app run tauri:dev:new",
		"tauri:build": "pnpm --filter vet-app run tauri:build",
		"tauri:appimage": "pnpm --filter vet-app run tauri:appimage",
		"tauri:deb": "pnpm --filter vet-app run tauri:deb",
		"tauri:flatpak": "node scripts/build-flatpak.mjs",
		"tauri:msi": "pnpm --filter vet-app run tauri:msi",
		"tauri:android:dev": "pnpm --filter vet-app run tauri:android:dev",
		"tauri:android:build": "pnpm --filter vet-app run tauri:android:build"
	}
}
