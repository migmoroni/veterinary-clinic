{
	"name": "veterinary-clinic",
	"private": true,
	"version": "0.2.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"test:run": "vitest run",
		"version:bump": "node scripts/bump-version.mjs",
		"tauri": "tauri",
		"tauri:dev": "tauri dev",
		"tauri:dev:new": "node scripts/new-state.mjs && node -e \"setTimeout(() => process.exit(0), 1000)\" && npm run tauri:dev",
		"tauri:build": "tauri build",
		"tauri:appimage": "tauri build --bundles appimage",
		"tauri:deb": "tauri build --bundles deb",
		"tauri:msi": "tauri build --bundles msi",
		"tauri:android:dev": "tauri android dev",
		"tauri:android:build": "tauri android build"
	},
	"devDependencies": {
		"@lucide/svelte": "^1.14.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.69.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.4",
		"@tauri-apps/cli": "^2.11.1",
		"@testing-library/svelte": "^5.3.1",
		"@types/node": "^25.6.2",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"jsdom": "^29.1.1",
		"svelte": "^5.56.0",
		"svelte-check": "^4.7.0",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.4",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.1.0",
		"vitest": "^4.1.9"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.11.0",
		"@tauri-apps/plugin-dialog": "^2.7.1",
		"@tauri-apps/plugin-fs": "^2.5.1",
		"@tauri-apps/plugin-shell": "^2.3.5",
		"@tauri-apps/plugin-sql": "^2.4.0"
	}
}
