{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compiled localized knowledge content",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sections"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sections": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sectionKey", "compiledMarkdown"],
        "properties": {
          "sectionKey": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z0-9][A-Za-z0-9]*(?:[._-][A-Za-z0-9]+)*$" },
          "compiledMarkdown": { "type": "string", "maxLength": 1000000 }
        }
      }
    }
  }
}
