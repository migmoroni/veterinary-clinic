{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compiled localized knowledge content",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sections"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sectionKey", "compiledMarkdown"],
        "properties": {
          "sectionKey": { "type": "string", "minLength": 1 },
          "compiledMarkdown": { "type": "string" }
        }
      }
    }
  }
}
