{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "Canonical treatment protocol", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "entityType", "id", "kind", "species", "productIds", "doses", "localizedContent"],
  "properties": { "schemaVersion": { "const": 1 }, "entityType": { "const": "treatment_protocol" }, "id": { "type": "string", "format": "uuid" }, "kind": { "enum": ["vaccine", "antiparasitic"] }, "species": { "type": "array", "minItems": 1, "uniqueItems": true }, "productIds": { "type": "array", "minItems": 1, "uniqueItems": true }, "doses": { "type": "array", "items": { "type": "object" } }, "localizedContent": { "type": "object" } }
}
