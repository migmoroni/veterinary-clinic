{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "Canonical breed", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "entityType", "id", "species", "originPlaceIds", "sizeTermKey", "averageWeightKg", "averageHeightCm", "localizedContent", "sections"],
  "properties": { "schemaVersion": { "const": 1 }, "entityType": { "const": "breed" }, "id": { "type": "string", "minLength": 1 }, "species": { "type": "array", "minItems": 1, "uniqueItems": true }, "originPlaceIds": { "type": "array", "minItems": 1, "uniqueItems": true }, "sizeTermKey": { "type": "string" }, "averageWeightKg": { "type": "object" }, "averageHeightCm": { "type": "object" }, "localizedContent": { "type": "object" }, "sections": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/section" } }, "contentPath": { "type": "string", "minLength": 1 } }
}
