{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "Canonical breed", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "entityType", "id", "species", "originPlaceIds", "sizeTermKey", "averageWeightKg", "averageHeightCm", "localizedContent", "sections"],
  "properties": {
    "schemaVersion": { "const": 1 }, "entityType": { "const": "breed" }, "id": { "$ref": "common.schema.json#/$defs/nonEmptyText" },
    "species": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["canine", "feline"] } }, "originPlaceIds": { "$ref": "common.schema.json#/$defs/nonEmptyStringArray" },
    "sizeTermKey": { "$ref": "common.schema.json#/$defs/key" }, "averageWeightKg": { "$ref": "common.schema.json#/$defs/measurementRange" }, "averageHeightCm": { "$ref": "common.schema.json#/$defs/measurementRange" },
    "localizedContent": { "$ref": "common.schema.json#/$defs/localizedContent" }, "sections": { "$ref": "common.schema.json#/$defs/sections" },
    "contentPath": { "$ref": "common.schema.json#/$defs/contentPath" }, "media": { "$ref": "common.schema.json#/$defs/media" }
  }
}
