{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "Canonical condition", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "entityType", "id", "typeTermKey", "classificationTermKeys", "regions", "localizedContent"],
  "properties": {
    "schemaVersion": { "const": 1 }, "entityType": { "const": "condition" }, "id": { "$ref": "common.schema.json#/$defs/uuidV4" },
    "typeTermKey": { "$ref": "common.schema.json#/$defs/key" }, "classificationTermKeys": { "$ref": "common.schema.json#/$defs/stringArray" }, "regions": { "$ref": "common.schema.json#/$defs/stringArray" },
    "localizedContent": { "$ref": "common.schema.json#/$defs/localizedContent" }, "sectionStandardKey": { "$ref": "common.schema.json#/$defs/sectionStandardKey" },
    "media": { "$ref": "common.schema.json#/$defs/media" }
  }
}
