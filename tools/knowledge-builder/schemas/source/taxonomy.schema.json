{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "Canonical taxonomy", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "entityType", "id", "domain", "purpose", "terms"],
  "properties": { "schemaVersion": { "const": 1 }, "entityType": { "const": "taxonomy" }, "id": { "type": "string", "minLength": 1 }, "domain": { "type": "string", "minLength": 1 }, "purpose": { "type": "string", "minLength": 1 }, "terms": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["key", "parentKey", "order", "localizedContent"], "properties": { "key": { "type": "string", "minLength": 1 }, "parentKey": { "type": ["string", "null"] }, "order": { "type": "integer", "minimum": 0 }, "localizedContent": { "type": "object" } } } } }
}
