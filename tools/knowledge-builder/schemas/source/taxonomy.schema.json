{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "Canonical taxonomy", "type": "object", "additionalProperties": false,
  "$defs": {
    "taxonomyTerm": {
      "type": "object", "additionalProperties": false, "required": ["key", "localizedContent"],
      "properties": {
        "key": { "$ref": "common.schema.json#/$defs/key" },
        "localizedContent": { "$ref": "common.schema.json#/$defs/localizedContent" },
        "children": { "type": "array", "minItems": 1, "maxItems": 10000, "items": { "$ref": "#/$defs/taxonomyTerm" } }
      }
    }
  },
  "required": ["schemaVersion", "entityType", "id", "domain", "purpose", "terms"],
  "properties": {
    "schemaVersion": { "const": 1 }, "entityType": { "const": "taxonomy" }, "id": { "$ref": "common.schema.json#/$defs/nonEmptyText" },
    "domain": { "$ref": "common.schema.json#/$defs/key" }, "purpose": { "$ref": "common.schema.json#/$defs/key" },
    "terms": { "type": "array", "minItems": 1, "maxItems": 10000, "items": { "$ref": "#/$defs/taxonomyTerm" } }
  }
}
