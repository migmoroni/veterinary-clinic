{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical product",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entityType", "id", "typeTermKey", "classificationTermKeys", "species", "regions", "manufacturerId", "activeIngredientIds", "regulatoryIdentifiers", "localizedContent", "sections"],
  "properties": {
    "schemaVersion": { "const": 1 }, "entityType": { "const": "product" }, "id": { "type": "string", "format": "uuid" },
    "typeTermKey": { "type": "string", "minLength": 1 }, "classificationTermKeys": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "species": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["canine", "feline"] } }, "regions": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "manufacturerId": { "type": "string", "format": "uuid" }, "activeIngredientIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "format": "uuid" } },
    "regulatoryIdentifiers": { "type": "object" }, "localizedContent": { "type": "object" }, "sections": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/section" } },
    "contentPath": { "type": "string", "minLength": 1 }, "targetTermKeys": { "type": "array", "minItems": 1, "uniqueItems": true }, "vaccineProfileTermKeys": { "type": "array", "minItems": 1, "uniqueItems": true },
    "lifeStageTermKeys": { "type": "array", "minItems": 1, "uniqueItems": true }, "therapeuticScopeTermKeys": { "type": "array", "minItems": 1, "uniqueItems": true }
  }
}
