{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "Canonical product", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "entityType", "id", "typeTermKey", "classificationTermKeys", "applicableTaxonTermKeys", "regions", "manufacturerId", "activeIngredientIds", "regulatoryIdentifiers", "localizedContent"],
  "properties": {
    "schemaVersion": { "const": 1 }, "entityType": { "const": "product" }, "id": { "$ref": "common.schema.json#/$defs/uuidV4" },
    "typeTermKey": { "$ref": "common.schema.json#/$defs/key" }, "classificationTermKeys": { "$ref": "common.schema.json#/$defs/stringArray" },
    "applicableTaxonTermKeys": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/key" } }, "regions": { "$ref": "common.schema.json#/$defs/stringArray" },
    "manufacturerId": { "$ref": "common.schema.json#/$defs/uuidV4" }, "activeIngredientIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/uuidV4" } },
    "regulatoryIdentifiers": { "$ref": "common.schema.json#/$defs/regulatoryIdentifiers" }, "localizedContent": { "$ref": "common.schema.json#/$defs/localizedContent" },
    "sectionStandardKey": { "$ref": "common.schema.json#/$defs/sectionStandardKey" }, "media": { "$ref": "common.schema.json#/$defs/media" },
    "targetTermKeys": { "$ref": "common.schema.json#/$defs/nonEmptyStringArray" },
    "applicableLifeStages": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "enum": ["newborn", "young", "adult"] } },
    "therapeuticSpectrum": { "enum": ["broad", "narrow"] }
  }
}
