{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical editorial section standards",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "standards"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "standards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "entityType", "sectionKeys"],
        "properties": {
          "key": { "$ref": "common.schema.json#/$defs/key" },
          "entityType": { "enum": ["active_ingredient", "condition", "life", "manufacturer", "product"] },
          "sectionKeys": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": { "$ref": "common.schema.json#/$defs/key" }
          }
        }
      }
    }
  }
}
