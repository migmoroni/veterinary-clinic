{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical life entity",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entityType", "id", "typeTermKey", "localizedContent", "sections"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "entityType": { "const": "life" },
    "id": { "$ref": "common.schema.json#/$defs/uuidV4" },
    "typeTermKey": { "$ref": "common.schema.json#/$defs/key" },
    "classifications": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "originPlaceIds": { "$ref": "common.schema.json#/$defs/nonEmptyStringArray" },
        "bodyMetrics": {
          "type": "object", "additionalProperties": false, "minProperties": 1,
          "properties": {
            "size": { "$ref": "common.schema.json#/$defs/key" },
            "stageMetrics": {
              "type": "object", "additionalProperties": false,
              "required": ["periodUnit", "male", "female"],
              "properties": {
                "periodUnit": { "enum": ["minutes", "hours", "days", "weeks", "months", "years"] },
                "male": { "$ref": "#/$defs/sexMetrics" },
                "female": { "$ref": "#/$defs/sexMetrics" }
              }
            }
          }
        }
      }
    },
    "localizedContent": {
      "type": "object", "additionalProperties": false, "required": ["aliases"],
      "properties": { "aliases": { "$ref": "common.schema.json#/$defs/localizedList" } }
    },
    "sections": { "$ref": "common.schema.json#/$defs/sections" },
    "contentPath": { "$ref": "common.schema.json#/$defs/contentPath" },
    "media": { "$ref": "common.schema.json#/$defs/media" }
  },
  "$defs": {
    "positiveRange": { "type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{ "type": "number", "exclusiveMinimum": 0 }, { "type": "number", "exclusiveMinimum": 0 }], "items": false },
    "period": { "type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{ "type": ["number", "null"], "minimum": 0 }, { "type": ["number", "null"], "minimum": 0 }], "items": false },
    "stage": {
      "type": "object", "additionalProperties": false, "required": ["period"], "minProperties": 2,
      "properties": {
        "period": { "$ref": "#/$defs/period" },
        "weight": { "type": "object", "additionalProperties": false, "required": ["live"], "properties": { "live": { "$ref": "#/$defs/positiveRange" } } },
        "measure": { "type": "object", "additionalProperties": false, "minProperties": 1, "properties": { "height": { "$ref": "#/$defs/positiveRange" }, "length": { "$ref": "#/$defs/positiveRange" } } }
      },
      "anyOf": [{ "required": ["weight"] }, { "required": ["measure"] }]
    },
    "sexMetrics": { "type": "object", "additionalProperties": false, "required": ["newborn", "young", "adult"], "properties": { "newborn": { "$ref": "#/$defs/stage" }, "young": { "$ref": "#/$defs/stage" }, "adult": { "$ref": "#/$defs/stage" } } }
  }
}
