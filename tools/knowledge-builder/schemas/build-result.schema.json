{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge builder result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "builderVersion", "buildVersion", "release", "sourceDigestSha256", "systemSchemaVersion", "systemMediaSchemaVersion", "locales", "cas", "projection", "checksumFile"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "builderVersion": { "type": "string", "minLength": 1 },
    "buildVersion": { "type": "integer", "minimum": 1 },
    "release": { "type": ["object", "null"] },
    "sourceDigestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "systemSchemaVersion": { "type": "integer", "minimum": 1 },
    "systemMediaSchemaVersion": { "type": "integer", "minimum": 1 },
    "locales": { "type": "object", "minProperties": 6, "maxProperties": 6 },
    "cas": { "type": "object" },
    "projection": { "type": "object" },
    "checksumFile": { "type": "string", "minLength": 1 }
  }
}
