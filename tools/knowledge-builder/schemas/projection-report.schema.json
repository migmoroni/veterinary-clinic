{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge projection evidence report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceDigestSha256",
    "buildVersion",
    "systemSchemaVersion",
    "systemMediaSchemaVersion",
    "source",
    "locales",
    "media"
  ],
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "positive": { "type": "integer", "minimum": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "entityCounts": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "active_ingredient": { "$ref": "#/$defs/count" },
        "life": { "$ref": "#/$defs/count" },
        "condition": { "$ref": "#/$defs/count" },
        "geo_place": { "$ref": "#/$defs/count" },
        "manufacturer": { "$ref": "#/$defs/count" },
        "product": { "$ref": "#/$defs/count" },
        "taxonomy": { "$ref": "#/$defs/count" },
        "treatment_protocol": { "$ref": "#/$defs/count" }
      }
    },
    "projectableSystemRows": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taxonomy_registry",
        "taxonomy_terms",
        "geo_places",
        "life_reference_items",
        "life_origin_places",
        "manufacturer_catalog_items",
        "active_ingredient_catalog_items",
        "condition_catalog_items",
        "product_catalog_items",
        "entity_taxonomy_terms",
        "product_active_ingredients",
        "treatment_protocols",
        "treatment_protocol_items",
        "treatment_protocol_doses",
        "entity_search_terms",
        "entity_media_references"
      ],
      "properties": {
        "taxonomy_registry": { "$ref": "#/$defs/count" },
        "taxonomy_terms": { "$ref": "#/$defs/count" },
        "geo_places": { "$ref": "#/$defs/count" },
        "life_reference_items": { "$ref": "#/$defs/count" },
        "life_origin_places": { "$ref": "#/$defs/count" },
        "manufacturer_catalog_items": { "$ref": "#/$defs/count" },
        "active_ingredient_catalog_items": { "$ref": "#/$defs/count" },
        "condition_catalog_items": { "$ref": "#/$defs/count" },
        "product_catalog_items": { "$ref": "#/$defs/count" },
        "entity_taxonomy_terms": { "$ref": "#/$defs/count" },
        "product_active_ingredients": { "$ref": "#/$defs/count" },
        "treatment_protocols": { "$ref": "#/$defs/count" },
        "treatment_protocol_items": { "$ref": "#/$defs/count" },
        "treatment_protocol_doses": { "$ref": "#/$defs/count" },
        "entity_search_terms": { "$ref": "#/$defs/count" },
        "entity_media_references": { "$ref": "#/$defs/count" }
      }
    },
    "typeProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entities", "rowsByTable"],
      "properties": {
        "entities": { "$ref": "#/$defs/count" },
        "rowsByTable": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "taxonomy_registry": { "$ref": "#/$defs/count" },
            "taxonomy_terms": { "$ref": "#/$defs/count" },
            "geo_places": { "$ref": "#/$defs/count" },
            "life_reference_items": { "$ref": "#/$defs/count" },
            "life_origin_places": { "$ref": "#/$defs/count" },
            "manufacturer_catalog_items": { "$ref": "#/$defs/count" },
            "active_ingredient_catalog_items": { "$ref": "#/$defs/count" },
            "condition_catalog_items": { "$ref": "#/$defs/count" },
            "product_catalog_items": { "$ref": "#/$defs/count" },
            "entity_taxonomy_terms": { "$ref": "#/$defs/count" },
            "product_active_ingredients": { "$ref": "#/$defs/count" },
            "treatment_protocols": { "$ref": "#/$defs/count" },
            "treatment_protocol_items": { "$ref": "#/$defs/count" },
            "treatment_protocol_doses": { "$ref": "#/$defs/count" },
            "entity_search_terms": { "$ref": "#/$defs/count" },
            "entity_media_references": { "$ref": "#/$defs/count" }
          }
        }
      }
    },
    "projectedTypes": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "active_ingredient": { "$ref": "#/$defs/typeProjection" },
        "life": { "$ref": "#/$defs/typeProjection" },
        "condition": { "$ref": "#/$defs/typeProjection" },
        "geo_place": { "$ref": "#/$defs/typeProjection" },
        "manufacturer": { "$ref": "#/$defs/typeProjection" },
        "product": { "$ref": "#/$defs/typeProjection" },
        "taxonomy": { "$ref": "#/$defs/typeProjection" },
        "treatment_protocol": { "$ref": "#/$defs/typeProjection" }
      }
    },
    "rowsByDatabase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "systemMedia"],
      "properties": {
        "system": { "$ref": "#/$defs/projectableSystemRows" },
        "systemMedia": {
          "type": "object",
          "additionalProperties": false,
          "required": ["media_assets"],
          "properties": { "media_assets": { "$ref": "#/$defs/count" } }
        }
      }
    },
    "locale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectedByType",
        "rowsByDatabase",
        "expectedObligationCount",
        "completedObligationCount",
        "rowEventCount",
        "operationCount",
        "resolvedRelationCount",
        "consumedLocalizedFragments",
        "evidenceDigestSha256"
      ],
      "properties": {
        "projectedByType": { "$ref": "#/$defs/projectedTypes" },
        "rowsByDatabase": { "$ref": "#/$defs/rowsByDatabase" },
        "expectedObligationCount": { "$ref": "#/$defs/count" },
        "completedObligationCount": { "$ref": "#/$defs/count" },
        "rowEventCount": { "$ref": "#/$defs/count" },
        "operationCount": { "$ref": "#/$defs/count" },
        "resolvedRelationCount": { "$ref": "#/$defs/count" },
        "consumedLocalizedFragments": { "$ref": "#/$defs/count" },
        "evidenceDigestSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "localizedCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pt-BR", "pt-PT", "gn-PY", "en-US", "es-ES", "fr-FR"],
      "properties": {
        "pt-BR": { "$ref": "#/$defs/count" },
        "pt-PT": { "$ref": "#/$defs/count" },
        "gn-PY": { "$ref": "#/$defs/count" },
        "en-US": { "$ref": "#/$defs/count" },
        "es-ES": { "$ref": "#/$defs/count" },
        "fr-FR": { "$ref": "#/$defs/count" }
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": 5 },
    "sourceDigestSha256": { "$ref": "#/$defs/sha256" },
    "buildVersion": { "$ref": "#/$defs/positive" },
    "systemSchemaVersion": { "$ref": "#/$defs/positive" },
    "systemMediaSchemaVersion": { "$ref": "#/$defs/positive" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entitiesByType", "relationCount", "localizedFragmentsByLocale", "sourceFiles"],
      "properties": {
        "entitiesByType": { "$ref": "#/$defs/entityCounts" },
        "relationCount": { "$ref": "#/$defs/count" },
        "localizedFragmentsByLocale": { "$ref": "#/$defs/localizedCounts" },
        "sourceFiles": { "$ref": "#/$defs/count" }
      }
    },
    "locales": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pt-BR", "pt-PT", "gn-PY", "en-US", "es-ES", "fr-FR"],
      "properties": {
        "pt-BR": { "$ref": "#/$defs/locale" },
        "pt-PT": { "$ref": "#/$defs/locale" },
        "gn-PY": { "$ref": "#/$defs/locale" },
        "en-US": { "$ref": "#/$defs/locale" },
        "es-ES": { "$ref": "#/$defs/locale" },
        "fr-FR": { "$ref": "#/$defs/locale" }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceFiles", "referencedMediaKeys", "uniqueContentHashes"],
      "properties": {
        "sourceFiles": { "$ref": "#/$defs/count" },
        "referencedMediaKeys": { "$ref": "#/$defs/count" },
        "uniqueContentHashes": { "$ref": "#/$defs/count" }
      }
    }
  }
}
