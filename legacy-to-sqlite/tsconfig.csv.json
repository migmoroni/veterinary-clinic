{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": "..",
    "paths": {
      "$lib/*": ["src/lib/*"]
    },
    "ignoreDeprecations": "6.0",
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "rootDir": "..",
    "outDir": "build/generated"
  },
  "include": [
    "to-sqlite.ts",
    "../src/lib/domain/medication/default-catalog.ts",
    "../src/lib/domain/medication/default-protocol.ts",
    "../src/lib/i18n/locales.ts",
    "../src/lib/i18n/medication-aliases/**/*.ts"
  ],
  "exclude": [
    "../src/lib/i18n/medication-aliases/**/__tests__/**"
  ]
}
