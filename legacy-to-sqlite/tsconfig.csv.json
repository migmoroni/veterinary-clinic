{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client"],
    "baseUrl": "..",
    "paths": {
      "$lib/*": ["src/lib/*"]
    },
    "ignoreDeprecations": "6.0",
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "rootDir": "..",
    "outDir": "build/generated"
  },
  "include": [
    "to-sqlite.ts",
    "../src/lib/domain/product/default-catalog.ts",
    "../src/lib/domain/treatment/default-protocol.ts",
    "../src/lib/i18n/locales.ts",
    "../src/lib/i18n/product-aliases/**/*.ts"
  ],
  "exclude": [
    "../src/lib/i18n/product-aliases/**/__tests__/**"
  ]
}
