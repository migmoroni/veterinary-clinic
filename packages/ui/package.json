{
	"name": "@vet/ui",
	"private": true,
	"version": "0.2.0",
	"type": "module",
	"svelte": "./src/index.ts",
	"exports": {
		".": {
			"svelte": "./src/index.ts",
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./charts": {
			"svelte": "./src/charts/index.ts",
			"types": "./src/charts/index.ts",
			"default": "./src/charts/index.ts"
		},
		"./charts/*": "./src/charts/*",
		"./*.js": "./src/*.ts",
		"./*.svelte": "./src/*.svelte",
		"./*": "./src/*"
	},
	"dependencies": {
		"@vet/core-local": "workspace:*",
		"@vet/types": "workspace:*",
		"clsx": "^2.1.1",
		"echarts": "^6.1.0"
	},
	"peerDependencies": {
		"@lucide/svelte": "^1.23.0",
		"svelte": "^5.56.4",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2"
	}
}
