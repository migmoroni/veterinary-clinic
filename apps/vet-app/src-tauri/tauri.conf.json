{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Veterinary Clinic",
  "version": "0.2.0",
  "identifier": "app.veterinary-clinic.local",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Veterinary Clinic",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "msi"],
    "publisher": "Miguel Eduardo Senna Moroni",
    "homepage": "https://github.com/migmoroni/veterinary-clinic",
    "copyright": "Copyright (c) 2026 Miguel Eduardo Senna Moroni",
    "license": "MIT",
    "licenseFile": "../../../LICENSE.md",
    "category": "Medical",
    "shortDescription": "Local-first veterinary clinic app",
    "longDescription": "Local-first veterinary clinic app for managing owners, pets, medical records, vaccinations, antiparasitic treatments, backups, imports and exports with a local SQLite database.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true,
        "files": {
          "Veterinary Clinic.desktop": "desktop/veterinary-clinic.appimage.desktop",
          "usr/share/metainfo/io.github.migmoroni.VeterinaryClinic.metainfo.xml": "metainfo/io.github.migmoroni.VeterinaryClinic.metainfo.xml",
          "usr/share/doc/veterinary-clinic/LICENSE.md": "../../../LICENSE.md"
        }
      },
      "deb": {
        "files": {
          "usr/share/metainfo/io.github.migmoroni.VeterinaryClinic.metainfo.xml": "metainfo/io.github.migmoroni.VeterinaryClinic.metainfo.xml",
          "usr/share/doc/Veterinary Clinic/copyright": "../../../LICENSE.md",
          "usr/share/doc/veterinary-clinic/copyright": "../../../LICENSE.md"
        },
        "section": "science",
        "priority": "optional",
        "changelog": "../../../CHANGELOG.md",
        "desktopTemplate": "desktop/veterinary-clinic.desktop.hbs"
      }
    }
  }
}
